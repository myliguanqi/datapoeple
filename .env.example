# 复制为 .env 后填写（.env 已在 .gitignore，不入库）。这里只有键名、注释和示例值，不放任何真实密钥。
# 代码只通过 live/settings/env.py 读取这些值；Web 只显示"已配置/未配置"，不回显。
# 修改 .env 后可在 Web「直播间设置 → 密钥」点「重新加载 .env」，不用重启。

# ---- Web / 接口写操作口令 ----
# 设置后，所有写接口（PUT/POST/DELETE）都要带请求头 X-Admin-Token；不设则只允许本机（127.0.0.1）执行写操作
ADMIN_TOKEN=

# ---- 大模型（OpenAI 兼容 /chat/completions）----
# 地址写到 /v1 或完整的 /chat/completions 都可以；不填则 LLM 不可用，台词全部走模板兜底
LLM_API_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
# 请求超时（秒）
LLM_TIMEOUT=10

# ---- 向量检索（可选；不填则知识库只用关键词检索）----
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# ---- 火山引擎 TTS（V3 HTTP SSE 声音复刻）----
# 新控制台 API Key
VOLC_TTS_API_KEY=
# 旧控制台鉴权（新控制台不用填）
VOLC_APP_ID=
VOLC_ACCESS_TOKEN=
# 声音复刻音色 ID（S_ 开头）；Web 上可覆盖
VOLC_VOICE_TYPE=
# 版本/计费：seed-icl-1.0 | seed-icl-1.0-concurr | seed-icl-2.0
VOLC_RESOURCE_ID=seed-icl-2.0

# ---- 抖音弹幕 ----
# 登录 cookie 文件路径（游客模式收不到礼物）；相对路径相对项目根目录。也可以在 Web 上粘贴（只写不读）
DOUYIN_COOKIE_FILE=secrets/douyin_cookie.txt
